{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": ".."
  },
  "include": ["./**/*.ts", "../scripts/**/*.ts", "../scripts/**/*.mts"]
}
