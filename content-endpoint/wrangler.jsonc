{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rvlry-content",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "content.jboxgames.com", "custom_domain": true }],
  "assets": {
    "directory": "../out/content-endpoint",
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "observability": { "enabled": false },
}
