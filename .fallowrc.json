{
  "$schema": "https://fallow.dev/schema.json",
  "entry": [
    "src/main.tsx",
    "src/**/*.test.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mts,mjs,js}"
  ],
  "ignorePatterns": [
    "android/**",
    "**/*.generated.*",
    "dist/**",
    "dist-ui-gallery/**",
    "build/**",
    "coverage/**",
    ".turbo/**",
    ".wrangler/**"
  ]
}
