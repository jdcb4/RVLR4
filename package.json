{
  "name": "jd-multiplayer-games",
  "version": "0.24.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "ui-gallery": "vite --config vite.ui-gallery.config.ts",
    "build": "tsc -b && vite build",
    "preview": "tsx --tsconfig server/tsconfig.json scripts/preview.mts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "smoke:server-imports": "tsx --tsconfig server/tsconfig.json scripts/smoke-server-imports.ts",
    "audit:names": "tsx scripts/audit-names.mts",
    "fallow:hygiene": "pnpm dlx fallow --no-cache --format human --only dead-code,dupes",
    "docker:build": "tsx scripts/build-docker.mts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "cuelume": "0.2.2",
    "express": "^4.21.2",
    "helmet": "8.3.0",
    "nanoid": "^5.1.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.21",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.23.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^3.2.7",
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.2.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y@6.10.2>eslint": "10.10.0"
      }
    },
    "overrides": {
      "body-parser@<1.20.6": "1.20.6",
      "qs@<6.16.0": "6.16.0",
      "socket.io-parser@<4.2.7": "4.2.7",
      "ws@<8.21.0": "8.21.0"
    }
  }
}
